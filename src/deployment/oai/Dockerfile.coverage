# OAI NRF Coverage Build — Clang source-based coverage for runtime dump
# Build: docker build -t oai-5gc-fuzz-coverage:latest -f Dockerfile.coverage .

ARG BASE_IMAGE=ubuntu:22.04

FROM ${BASE_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG BUILD_JOBS=2
ENV BUILD_JOBS=${BUILD_JOBS} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ca-certificates pkg-config \
    libssl-dev libcurl4-openssl-dev libmysqlclient-dev \
    libconfig++-dev libboost-all-dev libevent-dev \
    libgnutls28-dev libgcrypt-dev libsctp-dev \
    libspdlog-dev libmicrohttpd-dev nettle-dev libfmt-dev \
    libyaml-cpp-dev rapidjson-dev nlohmann-json3-dev libcrypto++-dev \
    gcc-12 g++-12 clang-14 lld-14 libnghttp2-dev libev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# ── CPR (use clang) ──
COPY _deps/cpr/ /tmp/cpr/
RUN cd /tmp/cpr && mkdir -p build && cd build \
    && cmake .. -DCPR_USE_SYSTEM_CURL=ON -DCPR_BUILD_TESTS=OFF \
    && cmake --build . --parallel "${BUILD_JOBS}" \
    && cmake --install . && rm -rf /tmp/cpr

# ── Pistache ──
COPY _deps/pistache/ /tmp/pistache/
RUN cd /tmp/pistache && mkdir -p _build && cd _build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
        -DPISTACHE_BUILD_EXAMPLES=false -DPISTACHE_BUILD_TESTS=false \
    && make -j"${BUILD_JOBS}" && make install && rm -rf /tmp/pistache

# ── nghttp2 ──
COPY _deps/nghttp2/ /tmp/nghttp2/
RUN cd /tmp/nghttp2 && cmake -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_LIB_ONLY=ON -DENABLE_ASIO_LIB=ON -DENABLE_STATIC_LIB=ON -DENABLE_SHARED_LIB=ON \
    && make -j"${BUILD_JOBS}" && make install \
    && cp -r src/includes/nghttp2/asio_http2*.h /usr/local/include/nghttp2/ \
    && rm -rf /tmp/nghttp2

# ── jwt-cpp ──
COPY _deps/jwt-cpp/include/jwt/ /usr/local/include/jwt/

# ── Common deps ──
COPY _deps/common-src/ /build/common-src/
COPY _deps/common-build/ /build/common-build/

# ── NRF with Clang coverage instrumentation ──
COPY component/oai-nrf/ /build/component/oai-nrf/
COPY build_nfs.sh /build/

RUN ln -sf /build/common-src /build/component/oai-nrf/common-src && \
    ln -sf /build/common-build /build/component/oai-nrf/common-build

RUN export OPENAIRCN_DIR=/build/component/oai-nrf && \
    rm -rf /build/build/nrf && mkdir -p /build/build/nrf && cd /build/build/nrf && \
    cmake /build/component/oai-nrf/build/nrf \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_C_COMPILER=gcc-12 \
        -DCMAKE_CXX_COMPILER=g++-12 \
        -DCMAKE_CXX_FLAGS="-fprofile-arcs -ftest-coverage" \
        -DCMAKE_C_FLAGS="-fprofile-arcs -ftest-coverage" \
        -DCMAKE_EXE_LINKER_FLAGS="-fprofile-arcs -lgcov" && \
    cmake --build . --parallel "${BUILD_JOBS}"

# ─── Runtime stage ─────────────────────────────────────────────
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libcurl4 libmysqlclient21 libconfig++9v5 \
    libboost-system1.74.0 libboost-thread1.74.0 \
    libevent-2.1-7 libevent-core-2.1-7 libevent-extra-2.1-7 \
    libgnutls30 libgcrypt20 libsctp1 libnghttp2-14 \
    libmicrohttpd12 libspdlog1 libyaml-cpp0.7 libfmt8 libnettle8 \
    lksctp-tools iproute2 tcpdump \
    libasan6 libev4 libboost-date-time1.74.0 libcrypto++8 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/oai /var/log/oai

COPY --from=builder /usr/local/lib/ /usr/local/lib/
RUN ldconfig

COPY --from=builder /build/build/nrf/nrf /usr/local/bin/oai_nrf
COPY --from=builder /build/component/oai-nrf /build/component/oai-nrf
# Preserve full build tree so all .gcno files (api-server, nrf_app sublibs) are available for gcov
COPY --from=builder /build/build/nrf /build/build/nrf

ENV GCOV_PREFIX=/tmp/coverage \
    GCOV_PREFIX_STRIP=0
RUN mkdir -p /tmp/coverage

# Need gcc-12 / gcov-12 in runtime to parse gcda files
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-12 \
    && rm -rf /var/lib/apt/lists/*

COPY configs/nrf.conf /etc/oai/nrf.conf
RUN sed -i 's/bind_address:.*/bind_address: 0.0.0.0/' /etc/oai/nrf.conf && \
    sed -i 's/port:.*/port: 80/' /etc/oai/nrf.conf

WORKDIR /etc/oai
EXPOSE 80 8080
CMD ["/usr/local/bin/oai_nrf", "-c", "/etc/oai/nrf.conf", "-o"]
